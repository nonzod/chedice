# Copy to `.env` to override defaults. All variables are optional.

# --- Transcription (faster-whisper) ---
# Model: tiny | base | small | medium | large-v3 (large-v3 = best accuracy)
APP_WHISPER_MODEL=large-v3
# Models selectable per job from the UI (the default above is always included).
APP_WHISPER_MODELS=tiny,base,small,medium,large-v3-turbo,large-v3
# Device: cuda | cpu
APP_DEVICE=cuda
# Compute type: float16 (GPU) | int8_float16 (GPU, lighter) | int8 (CPU)
APP_COMPUTE_TYPE=float16
# Force a language (e.g. it, en). Leave empty for automatic detection.
APP_LANGUAGE=
# Beam size for decoding (higher = slightly better, slower).
APP_BEAM_SIZE=5

# --- Speaker diarization (token-free ECAPA embeddings) ---
APP_DIARIZATION_ENABLED=true
# Minimum cosine separation between the two coarsest voice groups to accept
# more than one speaker (auto mode). Higher = more conservative / fewer speakers
# (raise if a single voice gets split); lower = splits more readily. Range ~0.5–0.8.
APP_SPEAKER_SEPARATION=0.65
APP_MIN_SPEAKERS=1
APP_MAX_SPEAKERS=10
# Embedding windows (seconds). Shorter windows / hops locate speaker changes more
# precisely but give noisier embeddings; smoothing compensates.
APP_WINDOW_SECONDS=2.0
APP_HOP_SECONDS=1.0
# Majority-vote smoothing over neighbouring windows (radius, 0 = off).
APP_SMOOTHING_RADIUS=1
# Speaker turns shorter than this (seconds) inside a sentence are absorbed by the
# surrounding speaker when splitting at word level.
APP_MIN_TURN_SECONDS=0.8

# --- Retention (defaults; editable from the UI ⚙️, 0 = never) ---
# Delete the original media of finished jobs after N days (transcript is kept).
APP_MEDIA_RETENTION_DAYS=0
# Delete finished jobs entirely after N days.
APP_JOB_RETENTION_DAYS=0

# --- Uploads ---
APP_MAX_UPLOAD_MB=4096

# --- LLM assistant (OpenAI-compatible; configured mostly from the UI ⚙️) ---
# Read timeout (seconds) for the streamed LLM response, applied between chunks.
# Raise it if a slow local model (big model / CPU / cold start) stalls.
APP_LLM_REQUEST_TIMEOUT=300
